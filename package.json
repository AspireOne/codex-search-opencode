  },
  "keywords": [
    "opencode-plugin",
    "opencode",
    "codex",
    "web-search",
    "openai",
    "research"
  ],
  "author": "Mateus DCC",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
