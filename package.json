{
  "name": "codex-search-opencode",
  "version": "2.0.0",
  "description": "Model-independent Codex web search and research plugin for OpenCode V2.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*",
    "templates/**/*",
    "README.md",
    "HOW-IT-WORKS.md",
    "HOW-IT-WAS-EXTRACT.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
